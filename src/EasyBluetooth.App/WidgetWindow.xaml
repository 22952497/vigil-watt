<Window
    x:Class="EasyBluetooth.App.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="EasyBluetooth 小组件">

    <Border x:Name="Root"
            CornerRadius="10"
            Padding="14,10"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            PointerPressed="Root_PointerPressed"
            PointerMoved="Root_PointerMoved"
            PointerReleased="Root_PointerReleased"
            PointerCaptureLost="Root_PointerReleased">
        <Border.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="打开主窗口" Click="OpenMain_Click" />
            </MenuFlyout>
        </Border.ContextFlyout>
        <StackPanel x:Name="ChipStack" Orientation="Vertical" Spacing="8" />
    </Border>
</Window>
