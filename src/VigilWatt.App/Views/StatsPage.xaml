<Page
    x:Class="VigilWatt.App.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*" Padding="20,16" RowSpacing="12">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <ComboBox x:Name="DeviceCombo" MinWidth="200" DisplayMemberPath="Display"
                      SelectionChanged="Device_SelectionChanged" />
            <ComboBox x:Name="RangeCombo" MinWidth="120" SelectedIndex="0" SelectionChanged="Range_SelectionChanged">
                <ComboBoxItem Content="最近 24 小时" Tag="24" />
                <ComboBoxItem Content="最近 7 天" Tag="168" />
                <ComboBoxItem Content="最近 30 天" Tag="720" />
            </ComboBox>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid x:Name="ChartHost" />
        </Border>
    </Grid>
</Page>
