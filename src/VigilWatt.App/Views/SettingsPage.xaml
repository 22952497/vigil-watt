<Page
    x:Class="VigilWatt.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- 设置行统一语言：左侧标题 + 说明，右侧控件（对齐 Windows 11 设置页的"标签左、控件右"布局）。
             说明：样式放在 Page.Resources，代码动态生成的插件行也复用同一套，保证两种来源的行长得一模一样。 -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <!-- 行内自带 0,12 的上下留白，卡片只留 4px 边距，视觉上等于每行 16px -->
            <Setter Property="Padding" Value="16,4" />
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" Padding="20,16">
            <StackPanel Spacing="18" MaxWidth="720" HorizontalAlignment="Left">

                <!-- 页面标题：与历史统计 / 历史管理页同款"标题 + 副标题" -->
                <StackPanel Spacing="2">
                    <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="提醒、数据采集、2.4G 插件与桌面小组件"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- 提醒 -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,0">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="提醒" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="低电量提醒阈值" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="低于该电量时弹托盘提醒，0 表示关闭" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <NumberBox Grid.Column="1" x:Name="ThresholdBox" Value="20"
                                           Minimum="0" Maximum="80" SpinButtonPlacementMode="Inline"
                                           Width="160" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="启动时最小化到托盘" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="开机后直接驻留托盘，不弹出主窗口" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="StartMinimizedToggle"
                                              OnContent="开" OffContent="关"
                                              MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="开机自动启动" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="写入当前用户的开机启动项（HKCU Run）" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="AutostartToggle"
                                              OnContent="开" OffContent="关"
                                              MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 数据采集 -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,0">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="数据采集" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="采样间隔" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="电量无变化时也按此间隔写一条历史（分钟）" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <NumberBox Grid.Column="1" x:Name="SampleBox" Value="5"
                                           Minimum="1" Maximum="60" SpinButtonPlacementMode="Inline"
                                           Width="160" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="历史保留天数" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="超过天数的历史记录会被自动清理（天）" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <NumberBox Grid.Column="1" x:Name="RetentionBox" Value="90"
                                           Minimum="7" Maximum="365" SpinButtonPlacementMode="Inline"
                                           Width="160" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 2.4G 设备插件 -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,0">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="2.4G 设备插件" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <!-- 开关由代码按已发现插件动态生成（DeviceManager.Plugins），新增品牌自动出现在这里 -->
                            <StackPanel x:Name="PluginPanel" />
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <TextBlock Margin="0,12,0,6" Style="{StaticResource RowDescStyle}"
                                       Text="2.4G 协议按品牌适配。识别不到设备时，可查看日志 %LOCALAPPDATA%\VigilWatt\logs\app.log" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 小组件 -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,0">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="小组件" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="桌面小组件" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="桌面悬浮电量条，可拖动、不进 Alt-Tab 与任务栏" Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="WidgetToggle"
                                          OnContent="开" OffContent="关"
                                          MinWidth="0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- 保存栏固定在底部，不再随内容滚走；左侧即时反馈，右侧主操作 -->
        <Border Grid.Row="1" Padding="20,12"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon x:Name="SavedIcon" Glyph="&#xE73E;" FontSize="14" Visibility="Collapsed"
                              Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock x:Name="SavedText" VerticalAlignment="Center" FontSize="13"
                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="SaveButton" Style="{ThemeResource AccentButtonStyle}"
                        Click="Save_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="保存设置" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
