<Page
    x:Class="VigilWatt.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,4" />
        </Style>
        <Style x:Key="CapTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="20,16">
        <StackPanel Spacing="0" MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="无线外设电量"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="VigilWatt" FontSize="32" FontWeight="SemiBold"
                       Margin="0,2,0,0" CharacterSpacing="-20" />
            <TextBlock x:Name="VersionText" FontSize="28" FontWeight="SemiBold"
                       Margin="0,8,0,0"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Border Width="72" Height="2" HorizontalAlignment="Left" Margin="0,10,0,0"
                    Background="{ThemeResource AccentFillColorDefaultBrush}" />

            <TextBlock Text="Windows 看不到 2.4G 外设电量，所以做了这个托盘。"
                       Margin="0,18,0,0" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,16,0,0">
                <TextBlock Text="蓝牙耳机" Style="{StaticResource CapTextStyle}" />
                <Border Width="1" Height="12" Margin="16,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <TextBlock Text="2.4G 键鼠手柄" Style="{StaticResource CapTextStyle}" />
                <Border Width="1" Height="12" Margin="16,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <TextBlock Text="可选的本机电量" Style="{StaticResource CapTextStyle}" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
                <StackPanel Spacing="8" Padding="0,12">
                    <TextBlock Text="功能简介" Style="{StaticResource RowTitleStyle}" FontWeight="SemiBold" />
                    <TextBlock Text="剩余时间估算：根据设备近期电量变化估算可用时间；采样不足或近期电量没有下降时，会提示当前原因。"
                               Style="{StaticResource RowDescStyle}" />
                    <TextBlock Text="右键重命名：在设备列表中右键设备，可设置更容易识别的自定义名称。"
                               Style="{StaticResource RowDescStyle}" />
                </StackPanel>
            </Border>

            <!-- 软件更新 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,28,0,0">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                        <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource RowTitleStyle}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="启动时自动检查 GitHub Release，连不上再回退 Gitee；发现新版本后会先征求确认"
                                           Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <ProgressBar x:Name="UpdateProgressBar" Height="6" Minimum="0" Maximum="100"
                                         Visibility="Collapsed" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="CheckUpdateButton"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="CheckUpdate_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE895;" FontSize="14" />
                                <TextBlock Text="检查更新" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 更新日志：内容来自随包的 release-notes.md，离线可看 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="更新日志" Style="{StaticResource RowTitleStyle}" FontWeight="SemiBold" />
                            <TextBlock Text="每个版本改了什么，随安装包分发，离线可看"
                                       Style="{StaticResource RowDescStyle}" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="1" Content="在 GitHub 查看"
                                         Click="OpenReleases_Click" VerticalAlignment="Center" />
                    </Grid>
                    <Border Style="{StaticResource RowDividerStyle}" />
                    <StackPanel x:Name="CurrentNotesHost" Padding="0,12" Spacing="6" />
                    <Expander x:Name="OlderNotesExpander" Header="更早的版本"
                              HorizontalAlignment="Stretch" Visibility="Collapsed">
                        <StackPanel x:Name="OlderNotesHost" Padding="0,4,0,12" Spacing="16" />
                    </Expander>
                </StackPanel>
            </Border>

            <!-- 项目 / 联系 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="项目" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="Gitee：YGWG-LX / vigil-watt" Style="{StaticResource RowDescStyle}" />
                            <TextBlock Text="GitHub：evren-oct / vigil-watt" Style="{StaticResource RowDescStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Click="OpenRepo_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                    <TextBlock Text="打开 Gitee" />
                                </StackPanel>
                            </Button>
                            <Button Click="OpenGitHub_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" FontSize="14" />
                                    <TextBlock Text="打开 GitHub" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource RowDividerStyle}" />
                    <StackPanel Spacing="2" Padding="0,12">
                        <TextBlock Text="联系" Style="{StaticResource RowTitleStyle}" />
                        <HyperlinkButton Content="xliu-oct@qq.com" Padding="0"
                                         NavigateUri="mailto:xliu-oct@qq.com" />
                    </StackPanel>
                    <Border Style="{StaticResource RowDividerStyle}" />
                    <TextBlock Text="MIT" Style="{StaticResource RowDescStyle}" Padding="0,12" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
