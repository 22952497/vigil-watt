<Window
    x:Class="VigilWatt.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="VigilWatt">

    <!-- Root 的背景由 MainWindow.ApplyBackdrop() 控制：
         Mica / Acrylic 模式下必须为 null（不透明背景会把材质整个盖住），
         只有 Solid 模式才铺一层分层色。 -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏融入区（背景透明让窗口材质透出来），SetTitleBar 挂载为拖拽区。
             标题在左侧，不会与右上角的系统按钮抢位置。 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <TextBlock Text="VigilWatt" Margin="16,0,0,0"
                       VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
        </Grid>

        <muxc:NavigationView x:Name="Nav" Grid.Row="1"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             PaneDisplayMode="Left"
                             OpenPaneLength="160"
                             SelectionChanged="Nav_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="设备电量" Tag="devices" IsSelected="True">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE702;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="历史统计" Tag="stats">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="历史管理" Tag="history">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="设置" Tag="settings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>
            <Grid>
                <muxc:Frame x:Name="ContentFrame" />
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
