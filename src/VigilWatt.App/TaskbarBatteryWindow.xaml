<Window
    x:Class="VigilWatt.App.TaskbarBatteryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VigilWatt 任务栏电量">

    <!--
      **本 Border 不画任何底色与边框**：贴片是"浮在任务栏上的一行读数"，不是一张卡片——加了底框就会在
      任务栏上糊出一个突兀的方块（用户 2026-10-10 反馈）。它只负责拖动命中区与右键菜单。
      内边距/格间距由 .cs 的 PadH/PadV/ChipGap 统一赋值，这里不写数字（改一边忘一边是上一版的坑）。
      窗口表面整体透明（Win11 走透明 SystemBackdrop，见 runtime-pitfalls §17），铺 ThemeResource 会直接透出底色，别加。
      **右键菜单走 RightTapped → Win32 原生菜单**（不是 ContextFlyout），原因见 runtime-pitfalls §18。
    -->
    <Border x:Name="Root"
            CornerRadius="8"
            BorderThickness="0"
            DoubleTapped="Root_DoubleTapped"
            RightTapped="Root_RightTapped"
            PointerPressed="Root_PointerPressed"
            PointerMoved="Root_PointerMoved"
            PointerReleased="Root_PointerReleased"
            PointerCaptureLost="Root_PointerReleased">
        <StackPanel x:Name="ChipStack" Orientation="Horizontal" />
    </Border>
</Window>
