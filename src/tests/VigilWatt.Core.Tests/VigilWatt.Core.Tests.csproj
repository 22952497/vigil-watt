<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>VigilWatt.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    直接链接被验证的源文件，测的是真代码，不是复制品。
    这些文件都刻意做成零依赖的纯逻辑，所以能脱离 WinRT 单独编译——
    正因如此这里用 <Compile Include> 而不是 ProjectReference：Core 的目标框架是
    net8.0-windows10.0.19041.0，本测试项目保持纯净的 net8.0（AnyCPU），
    不引入 Windows SDK / WinRT 依赖。改这两个源文件后必须重跑测试。
  -->
  <ItemGroup>
    <Compile Include="..\..\VigilWatt.Core\Plugins\BatteryReadingFilter.cs" />
    <Compile Include="..\..\VigilWatt.Core\Plugins\Mchose\MchoseV1Codec.cs" />
    <Compile Include="..\..\VigilWatt.Core\Plugins\Betop\BetopCodec.cs" />
    <Compile Include="..\..\VigilWatt.Core\Ble\ClassicDeviceName.cs" />
    <Compile Include="..\..\VigilWatt.Core\Models\DeviceKind.cs" />
    <Compile Include="..\..\VigilWatt.Core\Models\DeviceKindGuesser.cs" />
  </ItemGroup>

</Project>
